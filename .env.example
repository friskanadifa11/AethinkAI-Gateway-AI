# AethinkAI Gateway AI — local configuration.
# Copy to .env and replace every REPLACE_ value. `make bootstrap` does this for
# you and refuses to overwrite an existing .env.
#
# NEVER commit .env. Only this example file belongs in Git.

APP_ENV=development
APP_NAME="AethinkAI Gateway AI"

# Host:port the gateway listens on. Default is loopback-only on purpose.
HTTP_ADDR=127.0.0.1:8787
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Host port published by Compose (maps to 8080 inside the container).
GATEWAY_PORT=8787

# --- data stores -------------------------------------------------------------
DATABASE_URL=postgres://aethink:REPLACE_WITH_DB_PASSWORD@postgres:5432/aethink?sslmode=disable
POSTGRES_PASSWORD=REPLACE_WITH_DB_PASSWORD
REDIS_ADDR=redis:6379

# --- secrets (generate with: openssl rand -base64 32) -------------------------
# Keys provider-credential encryption and client-key hashing. Changing it makes
# stored provider credentials unreadable, so keep it stable and back it up.
APP_SECRET=REPLACE_WITH_RANDOM_32_PLUS_BYTES

# One-use token that authorises creating the first operator account.
BOOTSTRAP_TOKEN=REPLACE_WITH_RANDOM_32_PLUS_BYTES

# --- behaviour ---------------------------------------------------------------
LOG_LEVEL=info
SESSION_TTL_HOURS=72
REQUEST_METADATA_RETENTION_DAYS=30
PROVIDER_DEFAULT_TIMEOUT_SECONDS=60

# Cookie flag. true is only acceptable on plain-HTTP localhost; set false as
# soon as the console is served over HTTPS.
INSECURE_COOKIES=true

# Permit provider base URLs on private/loopback addresses (self-hosted upstreams).
ALLOW_PRIVATE_UPSTREAMS=true
RATE_LIMIT_FAIL_CLOSED=true

# --- integrations -------------------------------------------------------------
# CORS origins for the public API, comma separated. Empty sends no CORS headers
# at all: the public API is meant for servers unless you say otherwise.
# CORS_ORIGINS=https://app.example.com

# Bearer token for GET /metrics (Prometheus). Empty closes the endpoint, so a
# public tunnel cannot publish alias names and traffic counts by accident.
# METRICS_TOKEN=REPLACE_WITH_RANDOM_32_PLUS_BYTES
